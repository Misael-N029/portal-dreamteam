{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:dev": "node scripts/dev-schema.mjs && prisma db push --schema prisma/schema.dev.prisma",
    "db:setup": "npm run db:dev && tsx prisma/seed.ts",
    "db:reset": "node scripts/dev-schema.mjs && prisma db push --schema prisma/schema.dev.prisma --force-reset && tsx prisma/seed.ts",
    "db:deploy": "prisma db push",
    "db:init": "tsx prisma/init-prod.ts",
    "typecheck": "tsc --noEmit",
    "dev:worker": "tsx watch src/worker.ts",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "playwright": "^1.64.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
