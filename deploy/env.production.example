# Portal DreamTeam · copia este archivo a /var/www/portal/server/.env y completa los valores.
# Para cada clave aleatoria ejecuta en el VPS:  openssl rand -hex 32
# Permisos: chmod 600 /var/www/portal/server/.env

# Base de datos PostgreSQL (usuario y clave creados en el paso de base de datos)
DATABASE_URL="postgresql://portal:CLAVE_DE_POSTGRES@localhost:5432/portal"

# Sesiones: clave aleatoria larga. Si la cambias, todos deben volver a iniciar sesión.
JWT_SECRET=
# Cifrado de las contraseñas visibles con el ojito. Genérala una vez y NO la cambies nunca.
PASSWORD_VAULT_KEY=

PORT=4100
WEB_ORIGIN=https://portal.dreamteam.com.pe

# ── Centro de Reportes ──
# Lo normal es cargar estas conexiones desde el portal (Centro de Reportes → Conexiones), donde quedan cifradas.
# Lo que pongas aquí solo se usa si en el portal está vacío.
#CRM_EXPORT_URL=http://31.97.165.147/api/export/sales
#CRM_API_KEY=
#CRM_COMPANY_ID=1
#EVOLUTION_API_URL=
#EVOLUTION_API_KEY=
#EVOLUTION_INSTANCE=dreamteam
# NUNCA en producción: CRM_DEMO=1, EVOLUTION_API_URL=mock, SMTP_HOST=mock (son simulaciones de desarrollo)
